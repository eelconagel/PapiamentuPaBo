# Copy to .env and fill in.

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Host port, and which address it listens on. Keep 127.0.0.1 when a reverse
# proxy (Caddy/nginx) on the same server handles HTTPS.
PORT=8000
BIND_ADDRESS=127.0.0.1

# Number of reverse proxies in front of the site (0 = none). Needed so the
# rate limit sees the visitor's IP instead of the proxy's.
PROXY_COUNT=1

# 1 = session cookie only over HTTPS (production). Use 0 for plain-http testing.
COOKIE_SECURE=1

# Contact form limits
CONTACT_LIMIT_PER_IP_HOUR=5
CONTACT_LIMIT_PER_DAY=100

# Optional: e-mail me when a contact message arrives. Leave SMTP_HOST empty to disable.
# Port 587 uses STARTTLS, port 465 uses SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# ---------- Inloggen (optioneel) ----------
# Een knop verschijnt alleen als alle waarden van die provider zijn ingevuld.
# Stappen per provider staan in README.md. Callback-URL is steeds:
#   https://<jouw-domein>/auth/<provider>/callback   (google, microsoft, apple, facebook)

# Public address of the site, used to build those callback URLs (recommended).
PUBLIC_BASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple: Services ID, Team ID, Key ID and the contents of the .p8 key on one line,
# with the line breaks written as \n
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
